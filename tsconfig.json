{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "customConditions": [
      "node"
    ],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noImplicitOverride": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "browser-tests/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
