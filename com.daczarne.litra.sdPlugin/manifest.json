{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Litra",
  "Version": "0.2.0.0",
  "Author": "Daniel Czarnievicz",
  "Actions": [
    {
      "Name": "Power",
      "UUID": "com.daczarne.litra.power",
      "Icon": "imgs/actions/power/icon",
      "Tooltip": "Turn Litra lights on, off, or toggle.",
      "PropertyInspectorPath": "ui/power.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "UserTitleEnabled": false,
      "States": [
        {
          "Name": "Off",
          "Image": "imgs/actions/power/key-off",
          "TitleAlignment": "bottom",
          "ShowTitle": false
        },
        {
          "Name": "On",
          "Image": "imgs/actions/power/key-on",
          "TitleAlignment": "bottom",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Brightness",
      "UUID": "com.daczarne.litra.brightness",
      "Icon": "imgs/actions/brightness/icon",
      "Tooltip": "Set brightness on a key, or adjust with a dial (press toggles power).",
      "PropertyInspectorPath": "ui/brightness.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "UserTitleEnabled": true,
      "Encoder": {
        "layout": "$B1",
        "Icon": "imgs/actions/brightness/glyph",
        "TriggerDescription": {
          "Rotate": "Brightness",
          "Push": "Power",
          "Touch": "Lamps"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/brightness/key",
          "TitleAlignment": "bottom",
          "FontSize": 14,
          "TitleColor": "#ffffff"
        }
      ]
    },
    {
      "Name": "Temperature",
      "UUID": "com.daczarne.litra.temperature",
      "Icon": "imgs/actions/temperature/icon",
      "Tooltip": "Set color temperature on a key, or adjust with a dial (press toggles power).",
      "PropertyInspectorPath": "ui/temperature.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "UserTitleEnabled": true,
      "Encoder": {
        "layout": "$B1",
        "Icon": "imgs/actions/temperature/glyph",
        "TriggerDescription": {
          "Rotate": "Temperature",
          "Push": "Power",
          "Touch": "Lamps"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/temperature/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "TitleColor": "#ffffff"
        }
      ]
    },
    {
      "Name": "Scene",
      "UUID": "com.daczarne.litra.scene",
      "Icon": "imgs/actions/scene/icon",
      "Tooltip": "Turn Litra lights on at a brightness and a color temperature.",
      "PropertyInspectorPath": "ui/scene.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": true,
      "States": [
        {
          "Image": "imgs/actions/scene/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "TitleColor": "#ffffff"
        }
      ]
    },
    {
      "Name": "Brightness Up",
      "UUID": "com.daczarne.litra.brightness-up",
      "Icon": "imgs/actions/brightness-up/icon",
      "Tooltip": "Step Litra lights' brightness up.",
      "PropertyInspectorPath": "ui/brightness-step.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": true,
      "States": [
        {
          "Image": "imgs/actions/brightness-up/key",
          "TitleAlignment": "bottom",
          "FontSize": 14,
          "TitleColor": "#ffffff"
        }
      ]
    },
    {
      "Name": "Brightness Down",
      "UUID": "com.daczarne.litra.brightness-down",
      "Icon": "imgs/actions/brightness-down/icon",
      "Tooltip": "Step Litra lights' brightness down.",
      "PropertyInspectorPath": "ui/brightness-step.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": true,
      "States": [
        {
          "Image": "imgs/actions/brightness-down/key",
          "TitleAlignment": "bottom",
          "FontSize": 14,
          "TitleColor": "#ffffff"
        }
      ]
    },
    {
      "Name": "Temperature Up",
      "UUID": "com.daczarne.litra.temperature-up",
      "Icon": "imgs/actions/temperature-up/icon",
      "Tooltip": "Step Litra lights' color temperature up, cooler.",
      "PropertyInspectorPath": "ui/temperature-step.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": true,
      "States": [
        {
          "Image": "imgs/actions/temperature-up/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "TitleColor": "#ffffff"
        }
      ]
    },
    {
      "Name": "Temperature Down",
      "UUID": "com.daczarne.litra.temperature-down",
      "Icon": "imgs/actions/temperature-down/icon",
      "Tooltip": "Step Litra lights' color temperature down, warmer.",
      "PropertyInspectorPath": "ui/temperature-step.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": true,
      "States": [
        {
          "Image": "imgs/actions/temperature-down/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "TitleColor": "#ffffff"
        }
      ]
    }
  ],
  "Category": "Litra",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "Description": "Control Logitech Litra Beam lights from Stream Deck keys and dials.",
  "Icon": "imgs/plugin/marketplace",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "UUID": "com.daczarne.litra"
}
