{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "com.daczarne.litra.main",
  "items": [
    {
      "key": "heading",
      "type": "text",
      "rect": [ 16, 10, 136, 24 ],
      "alignment": "left",
      "font": {
        "size": 16,
        "weight": 600
      }
    },
    {
      "key": "icon",
      "type": "pixmap",
      "rect": [ 16, 40, 48, 48 ]
    },
    {
      "key": "value",
      "type": "text",
      "rect": [ 76, 40, 108, 32 ],
      "alignment": "right",
      "font": {
        "size": 24,
        "weight": 600
      }
    },
    {
      "key": "indicator",
      "type": "bar",
      "rect": [76, 74, 108, 12],
      "subtype": 4,
      "border_w": 0,
      "bar_bg_c": "#808080",
      "value": 0
    }
  ]
}
