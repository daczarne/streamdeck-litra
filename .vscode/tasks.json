{
  "version": "2.0.0",
  // Every task's terminal closes when the task exits, going back to the terminal that was open before. run-task.sh
  // keeps it open on failure, until Enter is pressed.
  "presentation": {
    "close": true,
  },
  "tasks": [
    // The default build task, so "Tasks: Run Build Task" runs it. The linked plugin runs the new build once restarted.
    {
      "label": "Build and restart",
      "detail": "Build the plugin, then restart it on the Deck",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'npm run build && npx streamdeck restart com.daczarne.litra'",
      "group": {
        "kind": "build",
        "isDefault": true,
      },
      "problemMatcher": [ ],
    },
    // Unlike CI, which runs its jobs in parallel, the compound tasks stop at the first check that fails.
    {
      "label": "CI",
      "detail": "Run every check from CI: the linters, then the tests",
      "dependsOn": [
        "Lint",
        "Test",
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint",
      "detail": "Run every linter",
      "dependsOn": [
        "Lint: Markdown",
        "Lint: spelling",
        "Lint: types",
        "Lint: code",
        "Lint: doc comments",
        "Lint: icons",
        "Lint: validate",
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint: Markdown",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'markdownlint-cli2 --config .markdownlint.yaml .'",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint: spelling",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'cspell lint --config .cspell.json --dot --no-progress .'",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint: code",
      "detail": "Biome: lint, formatting and import order",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'npm run lint'",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint: doc comments",
      "detail": "Every function, class, method and constructor has a doc comment",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'npm run check:docs'",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint: icons",
      "detail": "Regenerate the icons, which must change nothing in imgs/",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'npm run icons && git status --porcelain -- com.daczarne.litra.sdPlugin/imgs && test -z \"$(git status --porcelain -- com.daczarne.litra.sdPlugin/imgs)\"'",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint: types",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'npm run typecheck'",
      "problemMatcher": [
        "$tsc",
      ],
    },
    {
      "label": "Lint: validate",
      "detail": "check:ui, build and streamdeck validate",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'npm run validate'",
      "problemMatcher": [ ],
    },
    // The default test task, so "Tasks: Run Test Task" runs it.
    {
      "label": "Test",
      "detail": "Run the unit and integration tests, then the browser tests",
      "dependsOn": [
        "Test: unit and integration",
        "Test: browser",
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true,
      },
      "problemMatcher": [ ],
    },
    {
      "label": "Test: unit and integration",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'npm test'",
      "problemMatcher": [ ],
    },
    {
      "label": "Test: browser",
      "detail": "Drive the settings pages in a headless Chrome",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'npm run test:browser'",
      "problemMatcher": [ ],
    },
  ],
}
