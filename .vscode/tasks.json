{
  "version": "2.0.0",
  "tasks": [
    // Unlike CI, which runs its jobs in parallel, the compound tasks stop at the first check that fails.
    {
      "label": "CI",
      "detail": "Run every check from CI: the linters, then the tests",
      "dependsOn": [
        "Lint",
        "Test",
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint",
      "detail": "Run every linter",
      "dependsOn": [
        "Lint: Markdown",
        "Lint: spelling",
        "Lint: types",
        "Lint: validate",
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint: Markdown",
      "type": "shell",
      "command": "markdownlint-cli2 --config .markdownlint.yaml .",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint: spelling",
      "type": "shell",
      "command": "cspell lint --config .cspell.json --dot --no-progress .",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint: types",
      "type": "shell",
      "command": "npx tsc --noEmit -p .",
      "problemMatcher": [
        "$tsc",
      ],
    },
    {
      "label": "Lint: validate",
      "detail": "check:ui, build and streamdeck validate",
      "type": "shell",
      "command": "npm run validate",
      "problemMatcher": [ ],
    },
    // The default test task, so "Tasks: Run Test Task" runs it.
    {
      "label": "Test",
      "detail": "Run the unit tests, then the browser tests",
      "dependsOn": [
        "Test: unit",
        "Test: browser",
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true,
      },
      "problemMatcher": [ ],
    },
    {
      "label": "Test: unit",
      "type": "shell",
      "command": "npm test",
      "problemMatcher": [ ],
    },
    {
      "label": "Test: browser",
      "detail": "Drive the settings pages in a headless Chrome",
      "type": "shell",
      "command": "npm run test:browser",
      "problemMatcher": [ ],
    },
  ],
}
