{
  "name": "com.daczarne.litra",
  "version": "1.0.0",
  "private": true,
  "description": "Elgato Stream Deck plugin for Logitech Litra lights (Glow, Beam, Beam LX front light).",
  "license": "MIT",
  "author": "Seth Sheppard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daczarne/streamdeck-litra.git"
  },
  "bugs": {
    "url": "https://github.com/daczarne/streamdeck-litra/issues"
  },
  "homepage": "https://github.com/daczarne/streamdeck-litra#readme",
  "keywords": [
    "streamdeck",
    "elgato",
    "logitech",
    "litra",
    "lighting"
  ],
  "scripts": {
    "build": "rollup -c",
    "check:ui": "node scripts/check-ui.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.daczarne.litra\"",
    "link": "streamdeck link com.daczarne.litra.sdPlugin",
    "unlink": "streamdeck unlink com.daczarne.litra",
    "validate": "npm run check:ui && npm run build && streamdeck validate com.daczarne.litra.sdPlugin",
    "pack": "npm run check:ui && npm run build && streamdeck pack com.daczarne.litra.sdPlugin --force -o release --version 1.0.0.0"
  },
  "type": "module",
  "engines": {
    "node": "24.15.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.7.4",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.6",
    "rollup": "4.62.4",
    "sharp": "0.35.5",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.0",
    "litra": "4.5.1"
  }
}
