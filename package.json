{
  "name": "com.daczarne.litra",
  "version": "1.0.0",
  "private": true,
  "description": "Elgato Stream Deck plugin for Logitech Litra lights (Glow, Beam, Beam LX front light).",
  "license": "MIT",
  "author": "Daniel Czarnievicz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daczarne/streamdeck-litra.git"
  },
  "bugs": {
    "url": "https://github.com/daczarne/streamdeck-litra/issues"
  },
  "homepage": "https://github.com/daczarne/streamdeck-litra#readme",
  "keywords": [
    "streamdeck",
    "elgato",
    "logitech",
    "litra",
    "lighting"
  ],
  "scripts": {
    "build": "rollup -c",
    "check:docs": "node scripts/check-docs.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.daczarne.litra\"",
    "link": "streamdeck link com.daczarne.litra.sdPlugin",
    "unlink": "streamdeck unlink com.daczarne.litra",
    "validate": "npm run check:ui && npm run build && streamdeck validate com.daczarne.litra.sdPlugin",
    "pack": "npm run check:ui && npm run build && streamdeck pack com.daczarne.litra.sdPlugin --force -o release --version 1.0.0.0",
    "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.scripts.json",
    "lint": "biome ci",
    "format": "biome check --write --linter-enabled=false",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.mjs"
  },
  "type": "module",
  "engines": {
    "node": "24.15.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@daczarne/streamdeck-icons": "github:daczarne/streamdeck-icons#b8759c6bc42ae6ad0c5ccaa1e7576acfcc3311da",
    "@elgato/cli": "1.10.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.6",
    "rollup": "4.63.6",
    "sharp": "0.35.5",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.1",
    "@elgato/utils": "0.6.0",
    "litra": "4.5.1"
  }
}
